print "Plotting results for file: ", ARG1
working_directory = system("dirname ".ARG0)
output_file = outputfile = working_directory."/values.pdf"

set title "Inv. squareroot values (".ARG1.")"
set xlabel "x"
set ylabel "1/sqrt(x)"
set logscale x
set terminal pdf
set output output_file

plot ARG1 u 1:2 w l title "FP64 reference"
plot ARG1 u 1:3 w l title "FP32 algorithm"

print "Output wrote to          : ", output_file
