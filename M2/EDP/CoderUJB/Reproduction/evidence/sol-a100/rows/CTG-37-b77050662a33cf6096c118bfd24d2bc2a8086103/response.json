          "text": "```java\npublic void testGoodParse() {\n  String contents =\n      \"// goog.addDependency('ignored.js', ['ignored'], []);\\n\"\n      + \"/* A block comment containing a dependency:\\n\"\n      + \"goog.addDependency('also_ignored.js', [], ['ignored']);\\n\"\n      + \"*/\\n\"\n      + \"goog.addDependency('empty.js', [], []);\\n\"\n      + \"goog.addDependency(\\\"provides.js\\\", ['example.One', \\\"example.Two\\\"], []);\\n\"\n      + \"goog.addDependency('requires.js', [\\\"example.Three\\\"], \"\n      + \"['example.One', \\\"example.Two\\\"]); // trailing comment\\n\";\n\n  List<DependencyInfo> dependencies = parser.parseFile(SRC_PATH, contents);\n\n  assertEquals(0, errorManager.getErrorCount());\n  assertEquals(0, errorManager.getWarningCount());\n  assertEquals(3, dependencies.size());\n\n  DependencyInfo empty = dependencies.get(0);\n  assertEquals(\"empty.js\", empty.getPathRelativeToClosureBase());\n  assertEquals(EMPTY, empty.getProvides());\n  assertEquals(EMPTY, empty.getRequires());\n\n  DependencyInfo provides = dependencies.get(1);\n  assertEquals(\"provides.js\", provides.getPathRelativeToClosureBase());\n  assertEquals(\n      ImmutableList.of(\"example.One\", \"example.Two\"), provides.getProvides());\n  assertEquals(EMPTY, provides.getRequires());\n\n  DependencyInfo requires = dependencies.get(2);\n  assertEquals(\"requires.js\", requires.getPathRelativeToClosureBase());\n  assertEquals(ImmutableList.of(\"example.Three\"), requires.getProvides());\n  assertEquals(\n      ImmutableList.of(\"example.One\", \"example.Two\"), requires.getRequires());\n}\n```"
