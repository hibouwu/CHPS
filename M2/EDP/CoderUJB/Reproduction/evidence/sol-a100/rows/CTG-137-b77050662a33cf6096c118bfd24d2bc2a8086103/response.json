          "type": "output_text",
          "annotations": [],
          "logprobs": [],
          "text": "```java\n/**\n * Tests era, year, monthOfYear, dayOfMonth and dayOfWeek.\n */\npublic void testCalendar() {\n    // Ethiopic 1995-01-01 corresponds to ISO 2002-09-11 (Wednesday).\n    long millis = ISO_UTC.getDateTimeMillis(2002, 9, 11, 0);\n    int expectedDayOfWeek = DateTimeConstants.WEDNESDAY;\n\n    // Cover ordinary years, leap years and all month/year transitions.\n    for (int year = 1995; year <= 2000; year++) {\n        for (int month = 1; month <= 13; month++) {\n            int daysInMonth = month <= 12 ? 30 : (year % 4 == 3 ? 6 : 5);\n\n            for (int day = 1; day <= daysInMonth; day++) {\n                String message = \"Ethiopic \" + year + \"-\" + month + \"-\" + day;\n\n                assertEquals(message, EthiopicChronology.EE,\n                        ETHIOPIC_UTC.era().get(millis));\n                assertEquals(message, year,\n                        ETHIOPIC_UTC.year().get(millis));\n                assertEquals(message, month,\n                        ETHIOPIC_UTC.monthOfYear().get(millis));\n                assertEquals(message, day,\n                        ETHIOPIC_UTC.dayOfMonth().get(millis));\n                assertEquals(message, expectedDayOfWeek,\n                        ETHIOPIC_UTC.dayOfWeek().get(millis));\n\n                assertEquals(message, millis,\n                        ETHIOPIC_UTC.getDateTimeMillis(year, month, day, 0));\n\n                millis += MILLIS_PER_DAY;\n                expectedDayOfWeek = expectedDayOfWeek == DateTimeConstants.SUNDAY\n                        ? DateTimeConstants.MONDAY : expectedDayOfWeek + 1;\n            }\n        }\n    }\n\n    assertEquals(2001, ETHIOPIC_UTC.year().get(millis));\n    assertEquals(1, ETHIOPIC_UTC.monthOfYear().get(millis));\n    assertEquals(1, ETHIOPIC_UTC.dayOfMonth().get(millis));\n}\n```"
        }
