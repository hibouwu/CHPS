          "text": "```java\n@Test\npublic void testRfc4648Section10Decode() {\n    final String[][] vectors = {\n        {\"\", \"\"},\n        {\"Zg==\", \"f\"},\n        {\"Zm8=\", \"fo\"},\n        {\"Zm9v\", \"foo\"},\n        {\"Zm9vYg==\", \"foob\"},\n        {\"Zm9vYmE=\", \"fooba\"},\n        {\"Zm9vYmFy\", \"foobar\"}\n    };\n\n    for (final String[] vector : vectors) {\n        final String encoded = vector[0];\n        final String expected = vector[1];\n\n        assertEquals(\"Decoding String: \" + encoded,\n                expected, new String(Base64.decodeBase64(encoded), CHARSET_UTF8));\n        assertEquals(\"Decoding byte array: \" + encoded,\n                expected, new String(\n                        Base64.decodeBase64(encoded.getBytes(CHARSET_UTF8)),\n                        CHARSET_UTF8));\n    }\n}\n```"
