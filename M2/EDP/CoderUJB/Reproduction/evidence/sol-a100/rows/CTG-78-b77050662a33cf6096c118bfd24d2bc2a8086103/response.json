          "text": "```java\n/**\n * Test case for\n * <a href=\"https://issues.apache.org/jira/browse/COMPRESS-264\"\n * >COMPRESS-264</a>.\n */\n@Test\npublic void testReadingOfFirstStoredEntry() throws Exception {\n    final byte[] content = \"Contents of the first stored entry\"\n        .getBytes(Charset.forName(\"UTF-8\"));\n    final CRC32 crc = new CRC32();\n    crc.update(content);\n\n    final ByteArrayOutputStream archive = new ByteArrayOutputStream();\n    try (java.util.zip.ZipOutputStream out =\n             new java.util.zip.ZipOutputStream(archive)) {\n        final ZipEntry first = new ZipEntry(\"first.txt\");\n        first.setMethod(ZipEntry.STORED);\n        first.setSize(content.length);\n        first.setCompressedSize(content.length);\n        first.setCrc(crc.getValue());\n        out.putNextEntry(first);\n        out.write(content);\n        out.closeEntry();\n\n        // Ensure the first entry's stream stops before the next local header.\n        out.putNextEntry(new ZipEntry(\"second.txt\"));\n        out.write(\"Second entry\".getBytes(Charset.forName(\"UTF-8\")));\n        out.closeEntry();\n    }\n\n    zf = new ZipFile(new SeekableInMemoryByteChannel(archive.toByteArray()));\n    final Enumeration<ZipArchiveEntry> entries = zf.getEntries();\n    assertTrue(entries.hasMoreElements());\n\n    final ZipArchiveEntry first = entries.nextElement();\n    assertEquals(\"first.txt\", first.getName());\n    assertEquals(ZipEntry.STORED, first.getMethod());\n    assertEquals(content.length, first.getSize());\n\n    try (InputStream in = zf.getInputStream(first)) {\n        assertNotNull(in);\n        assertArrayEquals(content, IOUtils.toByteArray(in));\n        assertEquals(-1, in.read());\n    }\n}\n```"
