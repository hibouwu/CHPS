          "text": "```java\n@SuppressWarnings(\"resource\")\npublic byte[] quoteAsUTF8(String text)\n{\n    ByteArrayBuilder bytes = _bytes;\n    if (bytes == null) {\n        _bytes = bytes = new ByteArrayBuilder();\n    } else {\n        bytes.reset();\n    }\n\n    final int[] escapeCodes = CharTypes.get7BitOutputEscapes();\n    final int length = text.length();\n\n    for (int i = 0; i < length; ++i) {\n        int ch = text.charAt(i);\n\n        if (ch <= 0x7F) {\n            int escape = escapeCodes[ch];\n            if (escape == 0) {\n                bytes.append(ch);\n            } else {\n                bytes.append('\\\\');\n                if (escape > 0) {\n                    bytes.append(escape);\n                } else {\n                    bytes.append('u');\n                    bytes.append('0');\n                    bytes.append('0');\n                    bytes.append(HB[ch >> 4]);\n                    bytes.append(HB[ch & 0x0F]);\n                }\n            }\n        } else if (ch <= 0x7FF) {\n            bytes.append(0xC0 | (ch >> 6));\n            bytes.append(0x80 | (ch & 0x3F));\n        } else if (ch < SURR1_FIRST || ch > SURR2_LAST) {\n            bytes.append(0xE0 | (ch >> 12));\n            bytes.append(0x80 | ((ch >> 6) & 0x3F));\n            bytes.append(0x80 | (ch & 0x3F));\n        } else {\n            // A surrogate must be a high surrogate followed by a low surrogate.\n            if (ch > SURR1_LAST) {\n                _illegal(ch);\n            }\n            if (i + 1 >= length) {\n                _illegal(ch);\n            }\n\n            int codePoint = _convert(ch, text.charAt(++i));\n            bytes.append(0xF0 | (codePoint >> 18));\n            bytes.append(0x80 | ((codePoint >> 12) & 0x3F));\n            bytes.append(0x80 | ((codePoint >> 6) & 0x3F));\n            bytes.append(0x80 | (codePoint & 0x3F));\n        }\n    }\n\n    return bytes.toByteArray();\n}\n```"
