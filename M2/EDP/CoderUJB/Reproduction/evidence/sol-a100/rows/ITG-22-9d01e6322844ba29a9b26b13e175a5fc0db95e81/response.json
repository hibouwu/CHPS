          "text": "```java\npublic void testMapToProperties() throws Exception {\n    ObjectMapper mapper = new ObjectMapper();\n\n    Map<String, Object> input = new LinkedHashMap<String, Object>();\n    input.put(\"text\", \"value\");\n    input.put(\"integer\", Integer.valueOf(42));\n    input.put(\"decimal\", Double.valueOf(1.25));\n    input.put(\"boolean\", Boolean.TRUE);\n\n    Properties properties = mapper.convertValue(input, Properties.class);\n\n    assertEquals(input.size(), properties.size());\n    assertEquals(\"value\", properties.getProperty(\"text\"));\n    assertEquals(\"42\", properties.getProperty(\"integer\"));\n    assertEquals(\"1.25\", properties.getProperty(\"decimal\"));\n    assertEquals(\"true\", properties.getProperty(\"boolean\"));\n\n    // Properties must contain actual Strings, not the original value types.\n    for (Object value : properties.values()) {\n        assertTrue(value instanceof String);\n    }\n}\n```"
        }
