          "text": "```java\npublic void testFormat() {\n    final java.util.TimeZone timeZone = java.util.TimeZone.getTimeZone(\"GMT\");\n    final java.util.Locale locale = java.util.Locale.US;\n    final java.util.Calendar calendar =\n            new java.util.GregorianCalendar(timeZone, locale);\n    calendar.clear();\n    calendar.set(2003, java.util.Calendar.JANUARY, 1);\n\n    final java.util.Date date = calendar.getTime();\n\n    // Only exactly two 'y' characters should abbreviate the calendar year.\n    final String[] patterns = {\"y\", \"yy\", \"yyy\", \"yyyy\"};\n    final String[] expected = {\"2003\", \"03\", \"2003\", \"2003\"};\n\n    for (int i = 0; i < patterns.length; i++) {\n        final FastDateFormat fastFormat =\n                FastDateFormat.getInstance(patterns[i], timeZone, locale);\n        final java.text.SimpleDateFormat simpleFormat =\n                new java.text.SimpleDateFormat(patterns[i], locale);\n        simpleFormat.setTimeZone(timeZone);\n\n        assertEquals(\"Incorrect year for pattern \" + patterns[i],\n                expected[i], fastFormat.format(date));\n        assertEquals(\"Mismatch with SimpleDateFormat for pattern \" + patterns[i],\n                simpleFormat.format(date), fastFormat.format(date));\n    }\n}\n```"
        }
      ],
