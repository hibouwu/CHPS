          "text": "```java\npublic void testEmptyNodeSetOperations() {\n    try {\n        javax.xml.parsers.DocumentBuilderFactory factory =\n                javax.xml.parsers.DocumentBuilderFactory.newInstance();\n        org.w3c.dom.Document document = factory.newDocumentBuilder().parse(\n                new org.xml.sax.InputSource(\n                        new java.io.StringReader(\"<doc/>\")));\n\n        org.apache.commons.jxpath.JXPathContext context =\n                org.apache.commons.jxpath.JXPathContext.newContext(document);\n\n        String[] expressions = {\n            // An empty node-set compared with a number, in either order.\n            \"2.0 > child1\",\n            \"2.0 >= child1\",\n            \"2.0 < child1\",\n            \"2.0 <= child1\",\n            \"2.0 = child1\",\n            \"2.0 != child1\",\n            \"child1 > 2.0\",\n            \"child1 >= 2.0\",\n            \"child1 < 2.0\",\n            \"child1 <= 2.0\",\n            \"child1 = 2.0\",\n            \"child1 != 2.0\",\n\n            // Comparing two empty node-sets must also return false.\n            \"child1 > child2\",\n            \"child1 >= child2\",\n            \"child1 < child2\",\n            \"child1 <= child2\",\n            \"child1 = child2\",\n            \"child1 != child2\"\n        };\n\n        for (int i = 0; i < expressions.length; i++) {\n            assertEquals(\n                    \"Expected false for: \" + expressions[i],\n                    Boolean.FALSE,\n                    context.getValue(expressions[i], Boolean.class));\n        }\n    } catch (Exception e) {\n        throw new AssertionError(\"Failed to test empty node-set comparisons\", e);\n    }\n}\n```"
        }
