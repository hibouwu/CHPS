          "text": "```java\n@Test\npublic void testReadingOfFirstStoredEntry() throws Exception {\n    // Local file header and STORED entry data from COMPRESS-264.\n    final byte[] zip = {\n        0x50, 0x4b, 0x03, 0x04, 0x0a, 0x00,\n        0x00, 0x00, 0x00, 0x00, 0x03, 0x7b,\n        (byte) 0xd1, 0x42, (byte) 0x82, (byte) 0xc5,\n        (byte) 0xc1, (byte) 0xe6,\n        0x05, 0x00, 0x00, 0x00, 0x05, 0x00,\n        0x00, 0x00, 0x08, 0x00, 0x1c, 0x00,\n        0x74, 0x65, 0x73, 0x74, 0x2e, 0x74,\n        0x78, 0x74, 0x55, 0x54, 0x09, 0x00,\n        0x03, 0x56, 0x62, (byte) 0xbf, 0x51, 0x2a,\n        0x63, (byte) 0xbf, 0x51, 0x75, 0x78, 0x0b,\n        0x00, 0x01, 0x04, 0x01, (byte) 0xff, 0x01,\n        0x00, 0x04, (byte) 0x88, 0x13, 0x00, 0x00,\n        0x64, 0x61, 0x74, 0x61, 0x0a\n    };\n    final byte[] expected = { 0x64, 0x61, 0x74, 0x61, 0x0a };\n\n    // Verify both bulk reads and single-byte reads of the first entry.\n    for (int mode = 0; mode < 2; mode++) {\n        final ZipArchiveInputStream in = new ZipArchiveInputStream(\n                new java.io.ByteArrayInputStream(zip));\n        try {\n            final ZipArchiveEntry entry = in.getNextZipEntry();\n            org.junit.Assert.assertNotNull(entry);\n            org.junit.Assert.assertEquals(\"test.txt\", entry.getName());\n            org.junit.Assert.assertEquals(\n                    java.util.zip.ZipEntry.STORED, entry.getMethod());\n            org.junit.Assert.assertEquals(5L, entry.getSize());\n\n            final byte[] actual = new byte[expected.length];\n            if (mode == 0) {\n                int offset = 0;\n                while (offset < actual.length) {\n                    final int count = in.read(\n                            actual, offset, actual.length - offset);\n                    org.junit.Assert.assertTrue(\n                            \"Expected entry data rather than EOF or an empty read\",\n                            count > 0);\n                    offset += count;\n                }\n            } else {\n                for (int i = 0; i < actual.length; i++) {\n                    final int value = in.read();\n                    org.junit.Assert.assertTrue(\n                            \"Unexpected end of entry\", value >= 0);\n                    actual[i] = (byte) value;\n                }\n            }\n\n            org.junit.Assert.assertArrayEquals(expected, actual);\n            org.junit.Assert.assertEquals(-1, in.read());\n        } finally {\n            in.close();\n        }\n    }\n}\n```"
        }
