          "logprobs": [],
          "text": "```java\nimport com.fasterxml.jackson.dataformat.xml.XmlMapper;\nimport com.fasterxml.jackson.dataformat.xml.annotation.JacksonXmlElementWrapper;\nimport com.fasterxml.jackson.dataformat.xml.annotation.JacksonXmlProperty;\nimport com.fasterxml.jackson.dataformat.xml.annotation.JacksonXmlRootElement;\nimport org.junit.Test;\n\nimport java.util.ArrayList;\nimport java.util.List;\n\nimport static org.junit.Assert.*;\n\npublic class NestedUnwrappedLists180Test {\n\n    @JacksonXmlRootElement(localName = \"definition\")\n    public static class Definition {\n        @JacksonXmlElementWrapper(useWrapping = false)\n        @JacksonXmlProperty(localName = \"record\")\n        public List<Record> records = new ArrayList<Record>();\n    }\n\n    public static class Record {\n        @JacksonXmlProperty(isAttribute = true)\n        public String id;\n\n        @JacksonXmlElementWrapper(useWrapping = false)\n        @JacksonXmlProperty(localName = \"field\")\n        public List<Field> fields = new ArrayList<Field>();\n    }\n\n    public static class Field {\n        public String value;\n    }\n\n    @Test\n    public void testNestedUnwrappedLists180() throws Exception {\n        String xml =\n                \"<definition>\"\n              + \"  <record id=\\\"first\\\">\"\n              + \"    <field><value>a</value></field>\"\n              + \"    <field><value>b</value></field>\"\n              + \"  </record>\"\n              + \"  <record id=\\\"empty\\\"/>\"\n              + \"  <record id=\\\"last\\\">\"\n              + \"    <field><value>c</value></field>\"\n              + \"    <field><value>d</value></field>\"\n              + \"  </record>\"\n              + \"</definition>\";\n\n        Definition result = new XmlMapper().readValue(xml, Definition.class);\n\n        assertNotNull(result);\n        assertNotNull(result.records);\n        // The missing inner list must not split or merge outer records.\n        assertEquals(3, result.records.size());\n\n        Record first = result.records.get(0);\n        assertEquals(\"first\", first.id);\n        assertEquals(2, first.fields.size());\n        assertEquals(\"a\", first.fields.get(0).value);\n        assertEquals(\"b\", first.fields.get(1).value);\n\n        Record empty = result.records.get(1);\n        assertEquals(\"empty\", empty.id);\n        assertNotNull(empty.fields);\n        assertTrue(empty.fields.isEmpty());\n\n        Record last = result.records.get(2);\n        assertEquals(\"last\", last.id);\n        assertEquals(2, last.fields.size());\n        assertEquals(\"c\", last.fields.get(0).value);\n        assertEquals(\"d\", last.fields.get(1).value);\n    }\n}\n```"
