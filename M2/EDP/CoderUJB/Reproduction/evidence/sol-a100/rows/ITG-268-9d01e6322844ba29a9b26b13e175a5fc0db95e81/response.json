          "text": "```java\nimport org.jsoup.Jsoup;\nimport org.jsoup.nodes.Document;\nimport org.junit.Test;\n\nimport java.io.File;\nimport java.io.FileOutputStream;\nimport java.io.IOException;\n\nimport static org.junit.Assert.assertEquals;\n\npublic class DataUtilTest {\n    @Test\n    public void supportsBOMinFiles() throws IOException {\n        String[] encodings = {\"UTF-8\", \"UTF-16LE\", \"UTF-16BE\"};\n        byte[][] boms = {\n            {(byte) 0xEF, (byte) 0xBB, (byte) 0xBF},\n            {(byte) 0xFF, (byte) 0xFE},\n            {(byte) 0xFE, (byte) 0xFF}\n        };\n\n        String title = \"BOM encoding test\";\n        String text = \"H\\u00e9llo \\u4e16\\u754c\";\n        String html = \"<html><head><title>\" + title + \"</title></head>\"\n                + \"<body><p>\" + text + \"</p></body></html>\";\n\n        for (int i = 0; i < encodings.length; i++) {\n            File file = File.createTempFile(\"jsoup-bom-\", \".html\");\n            try {\n                try (FileOutputStream out = new FileOutputStream(file)) {\n                    out.write(boms[i]);\n                    out.write(html.getBytes(encodings[i]));\n                }\n\n                // No explicit charset: the parser must detect the raw BOM.\n                Document doc = Jsoup.parse(file, null, \"\");\n\n                assertEquals(encodings[i], title, doc.title());\n                assertEquals(encodings[i], text, doc.body().text());\n                // The BOM must not appear as document text.\n                assertEquals(encodings[i], title + \" \" + text, doc.text());\n            } finally {\n                if (!file.delete()) {\n                    file.deleteOnExit();\n                }\n            }\n        }\n    }\n}\n```"
