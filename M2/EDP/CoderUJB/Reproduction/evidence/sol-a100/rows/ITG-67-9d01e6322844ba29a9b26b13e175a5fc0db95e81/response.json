          "text": "```java\n@Test\npublic void testExactOptionNameMatch() throws ParseException {\n    Options options = new Options();\n    options.addOption(Option.builder()\n            .longOpt(\"importToOpen\")\n            .hasArg()\n            .argName(\"FILE\")\n            .build());\n    options.addOption(Option.builder(\"i\")\n            .longOpt(\"import\")\n            .hasArg()\n            .argName(\"FILE\")\n            .build());\n\n    // An exact match must take precedence over a longer option sharing its prefix.\n    CommandLine commandLine = new DefaultParser().parse(\n            options, new String[] {\"--import=FILE\"});\n\n    assertTrue(commandLine.hasOption(\"import\"));\n    assertTrue(commandLine.hasOption(\"i\"));\n    assertEquals(\"FILE\", commandLine.getOptionValue(\"import\"));\n    assertFalse(commandLine.hasOption(\"importToOpen\"));\n}\n```"
        }
