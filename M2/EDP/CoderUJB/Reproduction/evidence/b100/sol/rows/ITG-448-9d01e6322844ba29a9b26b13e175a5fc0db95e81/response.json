          "text": "    public void testFormat() {\n        final java.util.TimeZone timeZone = java.util.TimeZone.getTimeZone(\"UTC\");\n        final java.util.Locale locale = java.util.Locale.US;\n        final java.util.Calendar calendar =\n                new java.util.GregorianCalendar(timeZone, locale);\n        calendar.clear();\n        calendar.set(2003, java.util.Calendar.JULY, 15, 12, 0, 0);\n\n        final String[] patterns = {\"y\", \"yy\", \"yyy\", \"yyyy\", \"yyyyy\"};\n        final String[] expected = {\"2003\", \"03\", \"2003\", \"2003\", \"02003\"};\n\n        for (int i = 0; i < patterns.length; i++) {\n            final org.apache.commons.lang3.time.FastDateFormat format =\n                    org.apache.commons.lang3.time.FastDateFormat.getInstance(\n                            patterns[i], timeZone, locale);\n            assertEquals(\"Incorrect year formatting for pattern \" + patterns[i],\n                    expected[i], format.format(calendar.getTime()));\n        }\n    }"
        }
