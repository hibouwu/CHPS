          "text": "    @Test\n    public void shouldMatchCaptureArgumentsWhenArgsCountDoesNOTMatch() throws Exception {\n        java.io.PrintStream mock = org.mockito.Mockito.mock(java.io.PrintStream.class);\n        org.mockito.ArgumentCaptor<Object> captor =\n                org.mockito.ArgumentCaptor.forClass(Object.class);\n\n        mock.printf(\"%s %s\", \"first\", \"second\");\n\n        boolean verificationFailed = false;\n        try {\n            org.mockito.Mockito.verify(mock).printf(\n                    org.mockito.Mockito.eq(\"%s %s\"), captor.capture());\n        } catch (AssertionError expected) {\n            verificationFailed = true;\n        }\n\n        org.junit.Assert.assertTrue(\n                \"Verification should fail when argument counts differ\", verificationFailed);\n        org.junit.Assert.assertTrue(\n                \"Arguments should not be captured from a nonmatching invocation\",\n                captor.getAllValues().isEmpty());\n\n        org.mockito.Mockito.verify(mock).printf(\"%s %s\", \"first\", \"second\");\n    }"
        }
