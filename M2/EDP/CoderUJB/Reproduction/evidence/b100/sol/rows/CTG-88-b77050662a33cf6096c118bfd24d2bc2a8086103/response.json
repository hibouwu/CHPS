          "text": "    public void testDifferentDurationReturnDifferentObjects() {\n        UnsupportedDurationField weeksField = UnsupportedDurationField.getInstance(weeks);\n        UnsupportedDurationField monthsField = UnsupportedDurationField.getInstance(months);\n\n        UnsupportedDateTimeField first =\n                UnsupportedDateTimeField.getInstance(dateTimeFieldTypeOne, weeksField);\n        assertSame(first,\n                UnsupportedDateTimeField.getInstance(dateTimeFieldTypeOne, weeksField));\n\n        UnsupportedDateTimeField second =\n                UnsupportedDateTimeField.getInstance(dateTimeFieldTypeOne, monthsField);\n        assertNotSame(first, second);\n        assertSame(weeksField, first.getDurationField());\n        assertSame(monthsField, second.getDurationField());\n        assertSame(second,\n                UnsupportedDateTimeField.getInstance(dateTimeFieldTypeOne, monthsField));\n    }"
        }
