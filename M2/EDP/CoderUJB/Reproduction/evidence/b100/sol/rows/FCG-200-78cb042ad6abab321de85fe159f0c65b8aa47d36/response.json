          "text": "    public static byte[] mergeCentralDirectoryData(final ZipExtraField[] data) {\n        final boolean lastIsUnparseable = data.length > 0\n                && data[data.length - 1] instanceof UnparseableExtraFieldData;\n        final int regularCount = lastIsUnparseable ? data.length - 1 : data.length;\n        int length = WORD * regularCount;\n        for (final ZipExtraField field : data) {\n            length += field.getCentralDirectoryLength().getValue();\n        }\n\n        final byte[] result = new byte[length];\n        int offset = 0;\n        for (int i = 0; i < regularCount; i++) {\n            final ZipExtraField field = data[i];\n            System.arraycopy(field.getHeaderId().getBytes(), 0, result, offset, 2);\n            System.arraycopy(field.getCentralDirectoryLength().getBytes(), 0,\n                    result, offset + 2, 2);\n            offset += WORD;\n            final byte[] fieldData = field.getCentralDirectoryData();\n            System.arraycopy(fieldData, 0, result, offset, fieldData.length);\n            offset += fieldData.length;\n        }\n\n        if (lastIsUnparseable) {\n            final byte[] fieldData = data[data.length - 1].getCentralDirectoryData();\n            System.arraycopy(fieldData, 0, result, offset, fieldData.length);\n        }\n        return result;\n    }"
