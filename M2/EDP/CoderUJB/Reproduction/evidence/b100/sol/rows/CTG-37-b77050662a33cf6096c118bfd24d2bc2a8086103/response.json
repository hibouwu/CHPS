          "text": "  public void testGoodParse() {\n    String contents =\n        \"// A dependency in a comment must be ignored.\\n\"\n            + \"// goog.addDependency('ignored.js', ['ignored.Name'], []);\\n\"\n            + \"/* A block comment containing another dependency:\\n\"\n            + \"goog.addDependency('also_ignored.js', [], ['ignored.Require']);\\n\"\n            + \"*/\\n\"\n            + \"goog.addDependency('empty.js', [], []);\\n\"\n            + \"goog.addDependency(\\\"provides.js\\\", [\\\"example.One\\\", 'example.Two'], []);\\n\"\n            + \"goog.addDependency('requires.js', [], ['example.One', \\\"example.Two\\\"]);\\n\"\n            + \"goog.addDependency(\\\"both.js\\\", ['example.Three'], [\\\"example.One\\\"]);\\n\";\n\n    List<DependencyInfo> dependencies = parser.parseFile(SRC_PATH, contents);\n\n    assertEquals(0, errorManager.getErrorCount());\n    assertEquals(0, errorManager.getWarningCount());\n    assertEquals(4, dependencies.size());\n\n    DependencyInfo empty = dependencies.get(0);\n    assertEquals(\"empty.js\", empty.getPathRelativeToClosureBase());\n    assertEquals(EMPTY, empty.getProvides());\n    assertEquals(EMPTY, empty.getRequires());\n\n    DependencyInfo provides = dependencies.get(1);\n    assertEquals(\"provides.js\", provides.getPathRelativeToClosureBase());\n    assertEquals(ImmutableList.of(\"example.One\", \"example.Two\"), provides.getProvides());\n    assertEquals(EMPTY, provides.getRequires());\n\n    DependencyInfo requires = dependencies.get(2);\n    assertEquals(\"requires.js\", requires.getPathRelativeToClosureBase());\n    assertEquals(EMPTY, requires.getProvides());\n    assertEquals(ImmutableList.of(\"example.One\", \"example.Two\"), requires.getRequires());\n\n    DependencyInfo both = dependencies.get(3);\n    assertEquals(\"both.js\", both.getPathRelativeToClosureBase());\n    assertEquals(ImmutableList.of(\"example.Three\"), both.getProvides());\n    assertEquals(ImmutableList.of(\"example.One\"), both.getRequires());\n  }"
