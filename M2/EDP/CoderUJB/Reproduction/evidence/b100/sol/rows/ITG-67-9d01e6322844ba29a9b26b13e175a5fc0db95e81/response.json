          "text": "    @Test\n    public void testExactOptionNameMatch() throws ParseException {\n        Options options = new Options();\n        options.addOption(Option.builder().longOpt(\"importToOpen\").hasArg().argName(\"FILE\").build());\n        options.addOption(Option.builder(\"i\").longOpt(\"import\").hasArg().argName(\"FILE\").build());\n\n        CommandLine commandLine = new DefaultParser().parse(options, new String[] {\"--import=FILE\"});\n\n        assertTrue(commandLine.hasOption(\"import\"));\n        assertTrue(commandLine.hasOption(\"i\"));\n        assertEquals(\"FILE\", commandLine.getOptionValue(\"import\"));\n        assertEquals(\"FILE\", commandLine.getOptionValue(\"i\"));\n        assertFalse(commandLine.hasOption(\"importToOpen\"));\n        assertEquals(0, commandLine.getArgs().length);\n    }"
        }
