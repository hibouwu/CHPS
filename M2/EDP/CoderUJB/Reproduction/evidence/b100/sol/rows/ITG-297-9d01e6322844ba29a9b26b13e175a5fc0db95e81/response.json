          "text": "    public void testNestedUnwrappedLists180() throws Exception {\n        class Models {\n            public class Field {\n                public String value;\n            }\n\n            public class Record {\n                public String name;\n\n                @com.fasterxml.jackson.dataformat.xml.annotation.JacksonXmlElementWrapper(useWrapping = false)\n                @com.fasterxml.jackson.dataformat.xml.annotation.JacksonXmlProperty(localName = \"field\")\n                public java.util.List<Field> fields;\n            }\n\n            public class Definition {\n                @com.fasterxml.jackson.dataformat.xml.annotation.JacksonXmlElementWrapper(useWrapping = false)\n                @com.fasterxml.jackson.dataformat.xml.annotation.JacksonXmlProperty(localName = \"record\")\n                public java.util.List<Record> records;\n            }\n        }\n\n        final Models models = new Models();\n        com.fasterxml.jackson.databind.module.SimpleModule module =\n                new com.fasterxml.jackson.databind.module.SimpleModule();\n        module.addValueInstantiator(Models.Definition.class,\n                new com.fasterxml.jackson.databind.deser.ValueInstantiator.Base(Models.Definition.class) {\n                    @Override\n                    public boolean canCreateUsingDefault() {\n                        return true;\n                    }\n\n                    @Override\n                    public Object createUsingDefault(\n                            com.fasterxml.jackson.databind.DeserializationContext context) {\n                        return models.new Definition();\n                    }\n                });\n        module.addValueInstantiator(Models.Record.class,\n                new com.fasterxml.jackson.databind.deser.ValueInstantiator.Base(Models.Record.class) {\n                    @Override\n                    public boolean canCreateUsingDefault() {\n                        return true;\n                    }\n\n                    @Override\n                    public Object createUsingDefault(\n                            com.fasterxml.jackson.databind.DeserializationContext context) {\n                        return models.new Record();\n                    }\n                });\n        module.addValueInstantiator(Models.Field.class,\n                new com.fasterxml.jackson.databind.deser.ValueInstantiator.Base(Models.Field.class) {\n                    @Override\n                    public boolean canCreateUsingDefault() {\n                        return true;\n                    }\n\n                    @Override\n                    public Object createUsingDefault(\n                            com.fasterxml.jackson.databind.DeserializationContext context) {\n                        return models.new Field();\n                    }\n                });\n\n        com.fasterxml.jackson.dataformat.xml.XmlMapper mapper =\n                new com.fasterxml.jackson.dataformat.xml.XmlMapper();\n        mapper.registerModule(module);\n\n        String xml = \"<definition>\"\n                + \"<record><name>first</name>\"\n                + \"<field><value>a</value></field>\"\n                + \"<field><value>b</value></field></record>\"\n                + \"<record><name>empty</name></record>\"\n                + \"<record><name>last</name>\"\n                + \"<field><value>c</value></field>\"\n                + \"<field><value>d</value></field></record>\"\n                + \"</definition>\";\n\n        Models.Definition definition = mapper.readValue(xml, Models.Definition.class);\n\n        assertNotNull(definition.records);\n        assertEquals(3, definition.records.size());\n\n        Models.Record first = definition.records.get(0);\n        assertEquals(\"first\", first.name);\n        assertNotNull(first.fields);\n        assertEquals(2, first.fields.size());\n        assertEquals(\"a\", first.fields.get(0).value);\n        assertEquals(\"b\", first.fields.get(1).value);\n\n        Models.Record empty = definition.records.get(1);\n        assertEquals(\"empty\", empty.name);\n        assertTrue(empty.fields == null || empty.fields.isEmpty());\n\n        Models.Record last = definition.records.get(2);\n        assertEquals(\"last\", last.name);\n        assertNotNull(last.fields);\n        assertEquals(2, last.fields.size());\n        assertEquals(\"c\", last.fields.get(0).value);\n        assertEquals(\"d\", last.fields.get(1).value);\n    }"
        }
