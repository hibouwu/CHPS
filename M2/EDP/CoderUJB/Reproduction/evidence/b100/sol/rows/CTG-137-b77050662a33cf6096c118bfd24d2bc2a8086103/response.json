          "text": "    public void testCalendar() {\n        long millis = new DateTime(2002, 9, 11, 0, 0, 0, 0, ISO_UTC).getMillis();\n        int expectedDayOfWeek = DateTimeConstants.WEDNESDAY;\n\n        for (int year = 1995; year <= 1998; year++) {\n            for (int month = 1; month <= 13; month++) {\n                int daysInMonth = month <= 12 ? 30 : (year % 4 == 3 ? 6 : 5);\n                for (int day = 1; day <= daysInMonth; day++) {\n                    DateTime date = new DateTime(millis, ETHIOPIC_UTC);\n                    String message = \"Ethiopic date \" + year + \"-\" + month + \"-\" + day;\n\n                    assertEquals(message, EthiopicChronology.EE, date.getEra());\n                    assertEquals(message, year, date.getYear());\n                    assertEquals(message, month, date.getMonthOfYear());\n                    assertEquals(message, day, date.getDayOfMonth());\n                    assertEquals(message, expectedDayOfWeek, date.getDayOfWeek());\n                    assertEquals(message, millis,\n                            ETHIOPIC_UTC.getDateTimeMillis(year, month, day, 0));\n\n                    millis += MILLIS_PER_DAY;\n                    expectedDayOfWeek = expectedDayOfWeek == DateTimeConstants.SUNDAY\n                            ? DateTimeConstants.MONDAY : expectedDayOfWeek + 1;\n                }\n            }\n        }\n\n        assertEquals(new DateTime(2006, 9, 11, 0, 0, 0, 0, ISO_UTC).getMillis(), millis);\n        DateTime nextYear = new DateTime(millis, ETHIOPIC_UTC);\n        assertEquals(EthiopicChronology.EE, nextYear.getEra());\n        assertEquals(1999, nextYear.getYear());\n        assertEquals(1, nextYear.getMonthOfYear());\n        assertEquals(1, nextYear.getDayOfMonth());\n        assertEquals(DateTimeConstants.MONDAY, nextYear.getDayOfWeek());\n    }"
        }
