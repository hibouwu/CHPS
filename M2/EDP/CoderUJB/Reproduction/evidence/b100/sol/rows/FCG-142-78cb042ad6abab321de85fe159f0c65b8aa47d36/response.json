          "text": "    public static synchronized PeriodType forFields(DurationFieldType[] types) {\n        if (types == null || types.length == 0) {\n            throw new IllegalArgumentException(\"Types array must not be null or empty\");\n        }\n        types = types.clone();\n        for (DurationFieldType type : types) {\n            if (type == null) {\n                throw new IllegalArgumentException(\"Types array must not contain null\");\n            }\n        }\n\n        if (cTypes.isEmpty()) {\n            PeriodType[] predefined = {\n                standard(), yearMonthDayTime(), yearMonthDay(),\n                yearWeekDayTime(), yearWeekDay(), yearDayTime(), yearDay(),\n                dayTime(), time(), years(), months(), weeks(), days(),\n                hours(), minutes(), seconds(), millis()\n            };\n            for (PeriodType type : predefined) {\n                cTypes.put(type, type);\n            }\n        }\n\n        PeriodType key = new PeriodType(null, types, null);\n        Object cached = cTypes.get(key);\n        if (cached instanceof PeriodType) {\n            return (PeriodType) cached;\n        }\n        if (cached != null) {\n            throw new IllegalArgumentException(\"PeriodType does not support fields: \" + cached);\n        }\n\n        PeriodType result = standard();\n        List<DurationFieldType> remaining =\n                new ArrayList<DurationFieldType>(Arrays.asList(types));\n\n        if (!remaining.remove(DurationFieldType.years())) {\n            result = result.withYearsRemoved();\n        }\n        if (!remaining.remove(DurationFieldType.months())) {\n            result = result.withMonthsRemoved();\n        }\n        if (!remaining.remove(DurationFieldType.weeks())) {\n            result = result.withWeeksRemoved();\n        }\n        if (!remaining.remove(DurationFieldType.days())) {\n            result = result.withDaysRemoved();\n        }\n        if (!remaining.remove(DurationFieldType.hours())) {\n            result = result.withHoursRemoved();\n        }\n        if (!remaining.remove(DurationFieldType.minutes())) {\n            result = result.withMinutesRemoved();\n        }\n        if (!remaining.remove(DurationFieldType.seconds())) {\n            result = result.withSecondsRemoved();\n        }\n        if (!remaining.remove(DurationFieldType.millis())) {\n            result = result.withMillisRemoved();\n        }\n\n        if (!remaining.isEmpty()) {\n            cTypes.put(key, remaining);\n            throw new IllegalArgumentException(\n                    \"PeriodType does not support fields: \" + remaining);\n        }\n\n        Object canonical = cTypes.get(result);\n        if (canonical instanceof PeriodType) {\n            result = (PeriodType) canonical;\n        } else {\n            cTypes.put(result, result);\n        }\n        cTypes.put(key, result);\n        return result;\n    }"
