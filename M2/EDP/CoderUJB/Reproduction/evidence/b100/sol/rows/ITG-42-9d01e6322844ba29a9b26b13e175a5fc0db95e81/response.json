          "text": "    public void testEqualsAfterSerializationOfDerivedClass() throws IOException, ClassNotFoundException {\n        class DerivedMultiKey extends MultiKey<String> {\n            private static final long serialVersionUID = 1L;\n\n            DerivedMultiKey(final String first, final String second) {\n                super(first, second);\n            }\n        }\n\n        final DerivedMultiKey original = new DerivedMultiKey(\"bla\", \"blub\");\n\n        // Older compilers retain an unused reference to the enclosing test instance.\n        for (final java.lang.reflect.Field field : DerivedMultiKey.class.getDeclaredFields()) {\n            if (field.isSynthetic() && field.getName().startsWith(\"this$\")) {\n                try {\n                    field.setAccessible(true);\n                    field.set(original, null);\n                } catch (final IllegalAccessException ex) {\n                    throw new AssertionError(ex);\n                }\n            }\n        }\n\n        assertTrue(\"Use keys with a nonzero combined hash code\", original.hashCode() != 0);\n\n        final ByteArrayOutputStream bytes = new ByteArrayOutputStream();\n        try (ObjectOutputStream output = new ObjectOutputStream(bytes)) {\n            output.writeObject(original);\n        }\n\n        final Object restored;\n        try (ObjectInputStream input = new ObjectInputStream(\n                new ByteArrayInputStream(bytes.toByteArray()))) {\n            restored = input.readObject();\n        }\n\n        assertEquals(\"Deserialization must preserve the derived class\",\n                original.getClass(), restored.getClass());\n        assertEquals(\"Deserialization must preserve key equality\", original, restored);\n        assertEquals(\"Equal derived keys must retain equal hash codes after deserialization\",\n                original.hashCode(), restored.hashCode());\n    }"
        }
      ],
      "phase": "final_answer",
      "role": "assistant"
    }
