          "text": "    @Test\n    public void supportsBOMinFiles() throws IOException {\n        String html = \"<html><head><title>BOM test</title></head>\"\n                + \"<body><p>H\\u00e9llo \\u4e16\\u754c</p></body></html>\";\n        String[] encodings = {\"UTF-8\", \"UTF-16BE\", \"UTF-16LE\"};\n        byte[][] boms = {\n                {(byte) 0xEF, (byte) 0xBB, (byte) 0xBF},\n                {(byte) 0xFE, (byte) 0xFF},\n                {(byte) 0xFF, (byte) 0xFE}\n        };\n\n        for (int i = 0; i < encodings.length; i++) {\n            byte[] content = html.getBytes(encodings[i]);\n            byte[] input = new byte[boms[i].length + content.length];\n            System.arraycopy(boms[i], 0, input, 0, boms[i].length);\n            System.arraycopy(content, 0, input, boms[i].length, content.length);\n\n            org.jsoup.nodes.Document document = org.jsoup.Jsoup.parse(\n                    new java.io.ByteArrayInputStream(input), null, \"\");\n\n            org.junit.Assert.assertEquals(encodings[i], \"BOM test\", document.title());\n            org.junit.Assert.assertEquals(encodings[i], \"H\\u00e9llo \\u4e16\\u754c\",\n                    document.body().text());\n            org.junit.Assert.assertFalse(encodings[i],\n                    document.text().contains(\"\\uFEFF\"));\n        }\n    }"
        }
