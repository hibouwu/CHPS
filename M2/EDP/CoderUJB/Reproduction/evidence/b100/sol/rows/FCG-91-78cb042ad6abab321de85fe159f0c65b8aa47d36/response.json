          "text": "    public String soundex(String str) {\n        if (str == null) {\n            return null;\n        }\n        str = SoundexUtils.clean(str);\n        if (str.isEmpty()) {\n            return str;\n        }\n\n        final char[] code = {'0', '0', '0', '0'};\n        code[0] = str.charAt(0);\n        char last = map(str.charAt(0));\n        int count = 1;\n\n        for (int i = 1; i < str.length() && count < code.length; i++) {\n            final char mapped = map(str.charAt(i));\n            if (mapped == '#') {\n                continue;\n            }\n            if (mapped != '0' && mapped != last) {\n                code[count++] = mapped;\n            }\n            last = mapped;\n        }\n\n        return new String(code);\n    }"
