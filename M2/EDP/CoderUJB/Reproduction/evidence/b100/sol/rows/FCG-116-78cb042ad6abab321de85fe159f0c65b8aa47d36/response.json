          "text": "    private Token parseSimpleToken(final Token token, int ch) throws IOException {\n        while (true) {\n            if (readEndOfLine(ch)) {\n                token.type = EORECORD;\n                break;\n            }\n            if (isEndOfFile(ch)) {\n                token.type = EOF;\n                token.isReady = true;\n                break;\n            }\n            if (isDelimiter(ch)) {\n                token.type = TOKEN;\n                break;\n            }\n            if (isEscape(ch)) {\n                final int unescaped = readEscape();\n                if (unescaped == END_OF_STREAM) {\n                    token.content.append((char) ch).append((char) reader.getLastChar());\n                } else {\n                    token.content.append((char) unescaped);\n                }\n            } else {\n                token.content.append((char) ch);\n            }\n            ch = reader.read();\n        }\n        if (ignoreSurroundingSpaces) {\n            trimTrailingSpaces(token.content);\n        }\n        return token;\n    }"
