          "text": "    public void testSymbolTableExpansionBytes() throws Exception {\n        com.fasterxml.jackson.core.JsonFactory factory =\n                new com.fasterxml.jackson.core.JsonFactory();\n        java.util.Random random = new java.util.Random(216L);\n\n        for (int round = 0; round < 12; ++round) {\n            String[] names = new String[2000];\n            java.io.ByteArrayOutputStream output =\n                    new java.io.ByteArrayOutputStream();\n            com.fasterxml.jackson.core.JsonGenerator generator =\n                    factory.createGenerator(output);\n\n            try {\n                generator.writeStartObject();\n                for (int i = 0; i < names.length; ++i) {\n                    StringBuilder name = new StringBuilder();\n                    name.append(\"field_\").append(round).append('_').append(i);\n                    for (int j = 0; j < 8; ++j) {\n                        name.append('_').append(Long.toHexString(random.nextLong()));\n                    }\n                    names[i] = name.toString();\n                    generator.writeNumberField(names[i], i);\n                }\n                generator.writeEndObject();\n            } finally {\n                generator.close();\n            }\n\n            com.fasterxml.jackson.core.JsonParser parser =\n                    factory.createParser(output.toByteArray());\n            try {\n                assertEquals(com.fasterxml.jackson.core.JsonToken.START_OBJECT,\n                        parser.nextToken());\n                for (int i = 0; i < names.length; ++i) {\n                    assertEquals(names[i], parser.nextFieldName());\n                    assertEquals(names[i], parser.getCurrentName());\n                    assertEquals(com.fasterxml.jackson.core.JsonToken.VALUE_NUMBER_INT,\n                            parser.nextToken());\n                    assertEquals(i, parser.getIntValue());\n                }\n                assertEquals(com.fasterxml.jackson.core.JsonToken.END_OBJECT,\n                        parser.nextToken());\n                assertNull(parser.nextToken());\n            } finally {\n                parser.close();\n            }\n        }\n    }"
        }
