          "text": "    public void testEmptyNodeSetOperations() {\n        try {\n            org.w3c.dom.Document document =\n                    javax.xml.parsers.DocumentBuilderFactory.newInstance()\n                            .newDocumentBuilder()\n                            .parse(new org.xml.sax.InputSource(\n                                    new java.io.StringReader(\n                                            \"<?xml version=\\\"1.0\\\" encoding=\\\"UTF-8\\\"?><doc/>\")));\n            JXPathContext context = JXPathContext.newContext(document);\n\n            String[] expressions = {\n                \"2.0 > child1\",\n                \"2.0 >= child1\",\n                \"2.0 < child1\",\n                \"2.0 <= child1\",\n                \"2.0 = child1\",\n                \"2.0 != child1\",\n                \"child1 > 2.0\",\n                \"child1 >= 2.0\",\n                \"child1 < 2.0\",\n                \"child1 <= 2.0\",\n                \"child1 = 2.0\",\n                \"child1 != 2.0\",\n                \"child1 > child2\",\n                \"child1 >= child2\",\n                \"child1 < child2\",\n                \"child1 <= child2\",\n                \"child1 = child2\",\n                \"child1 != child2\",\n                \"child1 > /doc\",\n                \"child1 >= /doc\",\n                \"child1 < /doc\",\n                \"child1 <= /doc\",\n                \"child1 = /doc\",\n                \"child1 != /doc\",\n                \"/doc > child1\",\n                \"/doc >= child1\",\n                \"/doc < child1\",\n                \"/doc <= child1\",\n                \"/doc = child1\",\n                \"/doc != child1\"\n            };\n\n            for (int i = 0; i < expressions.length; i++) {\n                Boolean result = (Boolean) context.getValue(\n                        expressions[i], Boolean.class);\n                assertFalse(\"Expected false for: \" + expressions[i],\n                        result.booleanValue());\n            }\n        } catch (Exception e) {\n            fail(\"Could not evaluate empty node-set comparisons: \" + e);\n        }\n    }"
        }
