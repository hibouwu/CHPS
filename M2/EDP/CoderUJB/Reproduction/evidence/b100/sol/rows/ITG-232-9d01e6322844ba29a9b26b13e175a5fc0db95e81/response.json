          "text": "    public void testCodec112() {\n        byte[] input = new byte[] { 1, 2, 3 };\n        byte[] expected = new byte[] { 'A', 'Q', 'I', 'D' };\n\n        byte[] encoded = Base64.encodeBase64(input, false, false, 4);\n        assertTrue(java.util.Arrays.equals(expected, encoded));\n\n        encoded = Base64.encodeBase64(input, false, true, 4);\n        assertTrue(java.util.Arrays.equals(expected, encoded));\n\n        try {\n            Base64.encodeBase64(input, false, false, 3);\n            fail(\"Expected IllegalArgumentException when maxResultSize is too small\");\n        } catch (IllegalArgumentException expectedException) {\n            // Expected: four encoded bytes cannot fit within a limit of three.\n        }\n    }"
