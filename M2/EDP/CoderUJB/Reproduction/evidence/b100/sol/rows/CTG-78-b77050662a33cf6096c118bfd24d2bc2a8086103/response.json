          "type": "output_text",
          "annotations": [],
          "logprobs": [],
          "text": "    /**\n     * Regression test for COMPRESS-264.\n     */\n    @Test\n    public void testReadingOfFirstStoredEntry() throws Exception {\n        final byte[] expected = \"Contents of the first stored entry\".getBytes(\"UTF-8\");\n        final CRC32 crc = new CRC32();\n        crc.update(expected);\n\n        final ByteArrayOutputStream archive = new ByteArrayOutputStream();\n        try (java.util.zip.ZipOutputStream out = new java.util.zip.ZipOutputStream(archive)) {\n            final ZipEntry first = new ZipEntry(\"first.txt\");\n            first.setMethod(ZipEntry.STORED);\n            first.setSize(expected.length);\n            first.setCompressedSize(expected.length);\n            first.setCrc(crc.getValue());\n            out.putNextEntry(first);\n            out.write(expected);\n            out.closeEntry();\n\n            out.putNextEntry(new ZipEntry(\"second.txt\"));\n            out.write(\"Second entry\".getBytes(\"UTF-8\"));\n            out.closeEntry();\n        }\n\n        zf = new ZipFile(new SeekableInMemoryByteChannel(archive.toByteArray()));\n        final Enumeration<ZipArchiveEntry> entries = zf.getEntries();\n        assertTrue(entries.hasMoreElements());\n        final ZipArchiveEntry first = entries.nextElement();\n        assertEquals(\"first.txt\", first.getName());\n        assertEquals(ZipEntry.STORED, first.getMethod());\n        assertEquals(expected.length, first.getSize());\n\n        try (InputStream in = zf.getInputStream(first)) {\n            assertNotNull(in);\n            assertArrayEquals(expected, IOUtils.toByteArray(in));\n            assertEquals(-1, in.read());\n        }\n\n        try (InputStream in = zf.getInputStream(first)) {\n            for (final byte value : expected) {\n                assertEquals(value & 0xff, in.read());\n            }\n            assertEquals(-1, in.read());\n        }\n\n        assertTrue(entries.hasMoreElements());\n        assertEquals(\"second.txt\", entries.nextElement().getName());\n        assertFalse(entries.hasMoreElements());\n    }"
        }
      ],
