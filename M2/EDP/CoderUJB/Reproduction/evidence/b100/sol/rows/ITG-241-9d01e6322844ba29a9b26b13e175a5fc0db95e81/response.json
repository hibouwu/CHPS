          "text": "    public void testForID_String_old() {\n        DateTimeZone zone = DateTimeZone.forID(\"MET\");\n        long winter = new DateTime(2012, 1, 15, 12, 0, DateTimeZone.UTC).getMillis();\n        long summer = new DateTime(2012, 7, 15, 12, 0, DateTimeZone.UTC).getMillis();\n\n        assertEquals(\"MET should use Central European standard time\",\n                60 * 60 * 1000, zone.getOffset(winter));\n        assertEquals(\"MET should use Central European summer time\",\n                2 * 60 * 60 * 1000, zone.getOffset(summer));\n    }"
        }
