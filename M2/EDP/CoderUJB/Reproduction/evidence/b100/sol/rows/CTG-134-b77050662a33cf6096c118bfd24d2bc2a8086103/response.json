          "text": "    @Test\n    public void testMessageWithCorruptFileName() throws Exception {\n        final byte[] archive = new byte[31];\n        System.arraycopy(ZipLong.LFH_SIG.getBytes(), 0, archive, 0, 4);\n        archive[4] = 20;\n        archive[7] = 8; // UTF-8 filename flag.\n        archive[26] = 1; // Filename length.\n        archive[30] = (byte) 0xff; // Invalid UTF-8.\n\n        try (ZipArchiveInputStream in =\n                new ZipArchiveInputStream(new ByteArrayInputStream(archive))) {\n            try {\n                in.getNextZipEntry();\n                fail(\"Expected a ZipException for the corrupt entry name\");\n            } catch (final ZipException ex) {\n                Assert.assertNotNull(\"The exception should have a diagnostic message\", ex.getMessage());\n                assertTrue(\"The message should identify the corrupt entry name: \" + ex.getMessage(),\n                        ex.getMessage().contains(\"name\"));\n            }\n        }\n    }"
        }
      ],
