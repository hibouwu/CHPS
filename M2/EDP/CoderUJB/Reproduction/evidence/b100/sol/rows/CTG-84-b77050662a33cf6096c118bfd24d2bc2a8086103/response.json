          "text": "    @Test\n    public void testGetOneLineOneParser() throws IOException {\n        try (final CSVParser parser = new CSVParser(\n                new StringReader(CSV_INPUT_1 + \"\\n\" + CSV_INPUT_2 + \"\\n\"), CSVFormat.DEFAULT)) {\n            final Iterator<CSVRecord> iterator = parser.iterator();\n\n            assertTrue(iterator.hasNext());\n            final CSVRecord first = iterator.next();\n            assertEquals(RESULT[0].length, first.size());\n            for (int i = 0; i < RESULT[0].length; i++) {\n                assertEquals(RESULT[0][i], first.get(i));\n            }\n            assertEquals(1L, first.getRecordNumber());\n\n            assertTrue(iterator.hasNext());\n            final CSVRecord second = iterator.next();\n            assertEquals(RESULT[1].length, second.size());\n            for (int i = 0; i < RESULT[1].length; i++) {\n                assertEquals(RESULT[1][i], second.get(i));\n            }\n            assertEquals(2L, second.getRecordNumber());\n\n            assertFalse(iterator.hasNext());\n        }\n    }"
        }
