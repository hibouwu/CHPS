          "text": "    public void testMapToProperties() throws Exception {\n        com.fasterxml.jackson.databind.ObjectMapper mapper =\n                new com.fasterxml.jackson.databind.ObjectMapper();\n        java.util.Map<String, Object> source =\n                new java.util.LinkedHashMap<String, Object>();\n        source.put(\"text\", \"value\");\n        source.put(\"integer\", Integer.valueOf(42));\n        source.put(\"boolean\", Boolean.TRUE);\n        source.put(\"decimal\", Double.valueOf(1.25));\n\n        java.util.Properties properties =\n                mapper.convertValue(source, java.util.Properties.class);\n\n        assertEquals(source.size(), properties.size());\n        assertEquals(\"value\", properties.getProperty(\"text\"));\n        assertEquals(\"42\", properties.getProperty(\"integer\"));\n        assertEquals(\"true\", properties.getProperty(\"boolean\"));\n        assertEquals(\"1.25\", properties.getProperty(\"decimal\"));\n\n        for (Object value : properties.values()) {\n            assertTrue(value instanceof String);\n        }\n    }"
        }
